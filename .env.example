# Supabase — create a project at https://supabase.com, run supabase/migrations/0001_init.sql,
# then copy the Project URL and anon/public key from Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Brevo — create an account at https://www.brevo.com, verify a sender email address
# (Senders, Domains & Dedicated IPs > Senders), and copy your API key from
# SMTP & API > API Keys. These are read server-side only (by api/send-email.js),
# never exposed to the browser — do NOT prefix them with VITE_.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com

# Optional — defaults to sahrasaid845@gmail.com if unset. The inbox that receives
# contact-form notifications.
PRACTICE_EMAIL=sahrasaid845@gmail.com
